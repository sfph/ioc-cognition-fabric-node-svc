            "title": "Session Id",
            "type": "string"
          }
        },
        "required": [
          "session_id",
          "agent_replies"
        ],
        "title": "DecideRequest",
        "type": "object"
      },
      "ExtractionPayload": {
        "properties": {
          "data": {
            "description": "Extraction payload as a list of JSON objects. The objects are not validated by this service and are processed as-is. Clients must ensure each object matches the format specified by `metadata.format`.",
            "examples": [
              {
                "schema": "openclaw-conversation-v1",
                "session": {
                  "agentId": "agent-123",
                  "channel": "matrix",
                  "sessionId": "906630a9-bf57-48d8-bbae-9d41e7639d29"
                },
                "turns": [
                  {
                    "index": 0,
                    "model": "bedrock/global.anthropic.claude-haiku-4-5-20251001-v1:0",
                    "response": "Opening request from Engineering.",
                    "stopReason": "stop",
                    "timestamp": "2026-02-25T20:32:14.783Z",
                    "toolCalls": [],
                    "userMessage": "It's Q2 budget planning."
                  }
                ]
              }
            ],
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Data",
            "type": "array"
          },
          "metadata": {
            "$ref": "#/components/schemas/ExtractionPayloadMetadata",
            "description": "Metadata describing the format and interpretation of the payload."
          }
        },
        "required": [
          "metadata",
          "data"
        ],
        "title": "ExtractionPayload",
        "type": "object"
      },
      "ExtractionPayloadMetadata": {
        "properties": {
          "format": {
            "default": "openclaw",
            "description": "Payload format. Supported values: 'observe-sdk-otel' and 'openclaw'. Defaults to 'openclaw'.",
            "enum": [
              "observe-sdk-otel",
              "openclaw"
            ],
            "title": "Format",
            "type": "string"
          }
        },
        "title": "ExtractionPayloadMetadata",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Header": {
        "properties": {
          "agent_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
