{
  "components": {
    "schemas": {
      "Agent": {
        "description": "Participant metadata for a semantic negotiation session.",
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "title": "Agent",
        "type": "object"
      },
      "AgentReply": {
        "description": "A single agent reply used to advance an existing session.",
        "properties": {
          "action": {
            "enum": [
              "accept",
              "reject",
              "counter_offer"
            ],
            "title": "Action",
            "type": "string"
          },
          "agent_id": {
            "title": "Agent Id",
            "type": "string"
          },
          "offer": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Offer"
          }
        },
        "required": [
          "agent_id",
          "action"
        ],
        "title": "AgentReply",
        "type": "object"
      },
      "CreateOrUpdateRequest": {
        "additionalProperties": false,
        "properties": {
          "header": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Header"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional header of the request."
          },
          "payload": {
            "$ref": "#/components/schemas/ExtractionPayload"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Client-supplied request identifier for tracing and idempotency. If omitted, the service generates a UUID.",
            "example": "0f7c2b1e-8d0d-4d4d-9e2d-1a2b3c4d5e6f",
            "title": "Request Id"
          }
        },
        "required": [
          "payload"
        ],
        "title": "CreateOrUpdateRequest",
        "type": "object"
      },
      "CreateOrUpdateResponse": {
        "properties": {
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional message providing additional information.",
            "title": "Message"
          },
          "response_id": {
            "description": "ID of the response. This is populated from `request_id`.",
            "title": "Response Id",
            "type": "string"
          }
        },
        "required": [
          "response_id"
        ],
        "title": "CreateOrUpdateResponse",
        "type": "object"
      },
      "DecideRequest": {
        "description": "Request body to advance an existing semantic negotiation session.",
        "properties": {
          "agent_replies": {
            "items": {
              "$ref": "#/components/schemas/AgentReply"
            },
            "title": "Agent Replies",
            "type": "array"
          },
