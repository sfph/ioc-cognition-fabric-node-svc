        "operationId": "start_negotiation_api_workspaces__workspace_id__multi_agentic_systems__mas_id__semantic_negotiation_start_post",
        "parameters": [
          {
            "description": "Workspace ID",
            "in": "path",
            "name": "workspace_id",
            "required": true,
            "schema": {
              "description": "Workspace ID",
              "title": "Workspace Id",
              "type": "string"
            }
          },
          {
            "description": "Multi-Agentic System ID",
            "in": "path",
            "name": "mas_id",
            "required": true,
            "schema": {
              "description": "Multi-Agentic System ID",
              "title": "Mas Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InitiateNegotiationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
