            "type": "array"
          },
          "content_text": {
            "title": "Content Text",
            "type": "string"
          },
          "n_steps": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": 20,
            "title": "N Steps"
          },
          "session_id": {
            "title": "Session Id",
            "type": "string"
          }
        },
        "required": [
          "session_id",
          "content_text",
          "agents"
        ],
        "title": "InitiateNegotiationRequest",
        "type": "object"
      },
      "QueryRequest": {
        "additionalProperties": false,
        "properties": {
          "additional_context": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional additional context used to influence query processing. May include arbitrary JSON key-value pairs such as filters, user context, or execution hints.",
            "example": {
              "filters": {
                "environment": "prod"
              },
              "session_id": "abc-123"
            },
            "title": "Additional Context"
          },
          "header": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Header"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional header of the request."
          },
          "intent": {
            "description": "The user\u2019s query intent. This field is required and describes what the caller wants to search for or retrieve.",
            "example": "what does the website_selector_agent do?",
            "title": "Intent",
            "type": "string"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Client-supplied request identifier for tracing and idempotency. If omitted, the service generates a UUID.",
            "example": "0f7c2b1e-8d0d-4d4d-9e2d-1a2b3c4d5e6f",
            "title": "Request Id"
          },
          "search_strategy": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": "semantic_graph_traversal",
            "description": "Search strategy to use when processing the query. If omitted, defaults to `\"semantic_graph_traversal\"`.",
            "example": "semantic_graph_traversal",
            "title": "Search Strategy"
          }
        },
        "required": [
          "intent"
        ],
        "title": "QueryRequest",
        "type": "object"
      },
      "QueryResponse": {
        "properties": {
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional message providing additional information.",
            "title": "Message"
          },
          "response_id": {
